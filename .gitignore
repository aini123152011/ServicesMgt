# 仓库根忽略规则（各子项目另有局部 .gitignore）

# 环境变量（含密钥，禁止入库）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Node / 前端构建产物
node_modules/
dist/
coverage/

# 运行时产物
*.log
*.pid

# 部署打包产物（部署流程生成的 tar 包，不入库）
deploy-*.tar.gz

# 编辑器与系统文件
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
