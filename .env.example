# 平台本地开发环境变量模板 —— 复制为仓库根目录 .env 后按需修改
# platform/backend 按 app/core/config.py 锚定仓库根 .env 读取本文件；前端变量见 platform/frontend/.env.example

# 通用
PROJECT_NAME=BMC Services Platform
FASTAPI_ENV=development

# 安全
# JWT 签名密钥，生产环境必须替换
SECRET_KEY=changethis
# 访问令牌有效期（分钟），默认 60*24*8 = 8 天
# ACCESS_TOKEN_EXPIRE_MINUTES=11520

# 数据库
# postgres:// 或 postgresql:// 前缀会被自动改写为 psycopg 驱动
DATABASE_URL=postgresql://postgres:changethis@localhost:5432/bmc_platform

# 初始超管（prestart 阶段自动创建）
FIRST_SUPERUSER=admin@example.com
# 生产环境必须替换
FIRST_SUPERUSER_PASSWORD=changethis

# 邮件（可选，未配置 SMTP_HOST 时 emails_enabled=False）
# SMTP_HOST=smtp.example.com
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=noreply@example.com

# --------------------------------------------------------------------------- #
# 容器编排（compose.yaml）：镜像来源
# --------------------------------------------------------------------------- #
# IMAGE_PREFIX 是**完整仓库前缀、含结尾斜杠**，决定 compose 从哪里取镜像：
#   docker.io/<账号>/                 Docker Hub
#   ghcr.io/<账号>/                   GitHub GHCR（私有包需先 docker login）
#   <内网 GitLab 主机>:5050/<组>/<项目>/  内网 GitLab 容器仓库
#   留空                              用本地镜像（开发态，配 compose.build.yaml 构建）
IMAGE_PREFIX=
# 镜像 tag：latest 或具体版本（如 0.6.2 / 20260922），用于钉住部署版本
IMAGE_TAG=latest

# 平台自身容器的运行参数（compose 里用到；口令类必须改）
POSTGRES_USER=bmc
POSTGRES_PASSWORD=changethis
POSTGRES_DB=bmc_platform
# 前端访问地址（用于 CORS/邮件链接）
FRONTEND_HOST=http://localhost:18080
# 平台自更新的镜像仓库前缀，留空则界面不显示在线更新入口
UPDATE_REGISTRY=
