# 平台本地开发环境变量模板 —— 复制为仓库根目录 .env 后按需修改
# platform/backend 按 app/core/config.py 锚定仓库根 .env 读取本文件；前端变量见 platform/frontend/.env.example

# 通用
PROJECT_NAME=BMC Services Platform
FASTAPI_ENV=development

# 安全
# JWT 签名密钥，生产环境必须替换
SECRET_KEY=changethis
# 访问令牌有效期（分钟），默认 60*24*8 = 8 天
# ACCESS_TOKEN_EXPIRE_MINUTES=11520

# 数据库
# postgres:// 或 postgresql:// 前缀会被自动改写为 psycopg 驱动
DATABASE_URL=postgresql://postgres:changethis@localhost:5432/bmc_platform

# 初始超管（prestart 阶段自动创建）
FIRST_SUPERUSER=admin@example.com
# 生产环境必须替换
FIRST_SUPERUSER_PASSWORD=changethis

# 邮件（可选，未配置 SMTP_HOST 时 emails_enabled=False）
# SMTP_HOST=smtp.example.com
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=noreply@example.com

# --------------------------------------------------------------------------- #
# 容器编排（compose.yaml）：镜像来源
# --------------------------------------------------------------------------- #
# IMAGE_PREFIX 是**完整仓库前缀、含结尾斜杠**，决定 compose 从哪里取镜像：
#   docker.io/<账号>/                 Docker Hub
#   ghcr.io/<账号>/                   GitHub GHCR（公开包可直接拉；私有需先 docker login）
#   留空                              用本地镜像（开发态，配 compose.build.yaml 构建）
IMAGE_PREFIX=
# 镜像 tag：latest 或具体版本（如 0.6.2 / 20260922），用于钉住部署版本
IMAGE_TAG=latest

# 平台自身容器的运行参数（compose 里用到；口令类必须改）
POSTGRES_USER=bmc
POSTGRES_PASSWORD=changethis
POSTGRES_DB=bmc_platform
# 前端访问地址（用于 CORS/邮件链接）
FRONTEND_HOST=http://localhost:18080
# 平台自更新的镜像仓库前缀（仓库主机+命名空间，如 ghcr.io/<账号>，国内可写镜像站 ghcr.nju.edu.cn/<账号>）。
# 留空则平台不会主动拉取，只能靠「上传离线包」或宿主 `docker compose pull` 先把新镜像落到本地。
# 拉取时只把「镜像名:tag」拼在这个前缀后面——容器上已有的仓库前缀会被替换掉（不会拼成两段）
UPDATE_REGISTRY=

# --------------------------------------------------------------------------- #
# 二层测试网段（可选）：让被测 BMC 能在这个夹具上取址
#
# 留空 = 不启用（DHCP 只在容器网络内服务，实机验收用同网络的客户端容器验证）。
# 启用三步（细节见 docs/network-plan.md）：
#   1) 填下面两项；2) docker compose -f compose.yaml -f compose.l2.yaml up -d dhcp
#   3) 给测试口配址（必须 never-default，否则会抢走宿主默认路由）：
#      nmcli con mod <测试口> ipv4.addresses 192.168.90.1/24 ipv4.gateway "" ipv4.never-default yes
# --------------------------------------------------------------------------- #
# NOTE: 这一段由平台维护（设置页 → 宿主网口面板 → 启用 / 切换 / 停用）：页面会原子改写本文件的
# 这几个键。手工改也可以（平台以文件为准），改完在页面上点一次「应用」让 Docker 网络与之一致。
# 接 BMC 的那块宿主网口（macvlan 的 parent）；用 `ip -br addr` + carrier 判断哪块插了线
DHCP_PARENT_IFACE=
# 测试网段：必须避开管理网与 Docker 内部网段（172.30.x）
L2_SUBNET=
# 测试网段的 IPv6 前缀（如 fd00:90::/64）；BMC 测 v6 取址时需要，否则容器在测试段上没有 v6 地址
L2_SUBNET_V6=
# 测试网段的 IPv6 网关，即宿主测试口自己的 v6 地址（如 fd00:90::1）；同样必须给，否则容器会抢到 ::1
L2_GATEWAY_V6=
# 测试网段的网关，即宿主测试口自己的地址（如 192.168.90.1）。
# 必须显式给：不给时 Docker 的 IPAM 会把 .1 分给 dhcp 容器，与宿主测试口撞地址
# （同段两个 MAC 抢同一地址，BMC 侧 ARP 会来回跳；平台会报 address_conflict）
L2_GATEWAY=
# 需要在测试网段上被 BMC 访问的服务：macvlan 只给 dhcp，其余走宿主测试口地址
L2_SERVICES=dhcp,tftpd-hpa,rsyslog,chrony
