{#- nginx.conf.j2: 由平台自动渲染，写入 /etc/nginx-bmc/nginx.conf -#}
{#- NOTE: user 指令必须显式写出来。平台用 -c 指定本配置，镜像里 /etc/nginx/nginx.conf
    的 `user www-data;` 不会生效，缺省会退化成编译期的 nobody——而数据目录 /data/nginx
    与 Basic 认证凭据都属 www-data，worker 以 nobody 运行会导致上传写入被拒（403/500）
    且读不到凭据文件。-#}
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    client_max_body_size {{ max_upload_size_mb }}m;

    server {
        listen {{ listen_port }};
        listen [::]:{{ listen_port }};
        server_name _;

        root /data/nginx;

        {% if auth_basic_enabled %}
        auth_basic "BMC Service Access";
        auth_basic_user_file /etc/nginx-bmc/htpasswd;
        {% endif %}

        {% if fault_mode == 'http_status' %}
        # BMC 故障注入模式：拦截所有请求并返回指定的异常状态码
        location / {
            return {{ mock_status_code }} "BMC fault injection: simulated HTTP error\n";
        }
        {% else %}
        location / {
            {% if fault_mode == 'corrupt_content_length' %}
            # BMC 故障注入：声明一个远大于实际文件的 Content-Length。
            # nginx 仍会发自己的真实长度，于是响应里出现两个 Content-Length（实测客户端
            # 直接下载失败/挂起）——用来测 BMC 遇到「固件下载长度不符」时的处理。
            add_header Content-Length 99999999 always;
            {% endif %}
            {% if autoindex %}
            autoindex on;
            autoindex_exact_size off;
            autoindex_localtime on;
            {% else %}
            autoindex off;
            {% endif %}

            {% if enable_upload %}
            dav_methods PUT DELETE MKCOL COPY MOVE;
            create_full_put_path on;
            dav_access all:rw;
            {% endif %}

            {% if fault_mode == 'extreme_slow' %}
            # BMC 故障注入模式：极端限速测试客户端超时
            limit_rate {{ throttle_rate_kbs }}k;
            {% endif %}
            # NOTE: 此处不能加 try_files：它在 precontent 阶段运行，对不存在的文件直接
            # 返回 404，会让 DAV 的 PUT 无法新建文件（上传固件正是这条路径）。
            # 静态文件缺失由 root 处理器自然返回 404，不需要 try_files 兜底。
        }
        {% endif %}
    }

    {% if ssl_enabled %}
    server {
        listen {{ ssl_port }} ssl;
        listen [::]:{{ ssl_port }} ssl;
        server_name _;

        root /data/nginx;

        ssl_certificate /etc/nginx-bmc/ssl/cert.pem;
        ssl_certificate_key /etc/nginx-bmc/ssl/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        {% if auth_basic_enabled %}
        auth_basic "BMC Service Access";
        auth_basic_user_file /etc/nginx-bmc/htpasswd;
        {% endif %}

        {% if fault_mode == 'http_status' %}
        location / {
            return {{ mock_status_code }} "BMC fault injection: simulated HTTPS error\n";
        }
        {% else %}
        location / {
            {% if fault_mode == 'corrupt_content_length' %}
            # BMC 故障注入：声明一个远大于实际文件的 Content-Length。
            # nginx 仍会发自己的真实长度，于是响应里出现两个 Content-Length（实测客户端
            # 直接下载失败/挂起）——用来测 BMC 遇到「固件下载长度不符」时的处理。
            add_header Content-Length 99999999 always;
            {% endif %}
            {% if autoindex %}
            autoindex on;
            autoindex_exact_size off;
            autoindex_localtime on;
            {% endif %}

            {% if enable_upload %}
            dav_methods PUT DELETE MKCOL COPY MOVE;
            create_full_put_path on;
            dav_access all:rw;
            {% endif %}

            {% if fault_mode == 'extreme_slow' %}
            limit_rate {{ throttle_rate_kbs }}k;
            {% endif %}
            # NOTE: 同 HTTP 段，try_files 会挡住 DAV 的 PUT 新建文件，这里同样不能加
        }
        {% endif %}
    }
    {% endif %}
}
