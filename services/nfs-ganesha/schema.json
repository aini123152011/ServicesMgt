{
  "fields": [
    {
      "name": "export_path",
      "type": "string",
      "label": "NFS 共享导出路径",
      "default": "/data/nfs",
      "pattern": "^/([a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+$",
      "required": true,
      "group": "base"
    },
    {
      "name": "export_id",
      "type": "integer",
      "label": "NFS 导出条目唯一 ID",
      "default": 1,
      "min": 1,
      "max": 65535,
      "required": true,
      "group": "base"
    },
    {
      "name": "allowed_clients",
      "type": "string",
      "label": "允许挂载的客户端网段",
      "help": "通配符 * 或 CIDR（IPv4/IPv6，如 192.168.0.0/16、fd00::/64）",
      "default": "*",
      "group": "base",
      "pattern": "^\\*$|^([0-9]{1,3}\\.){3}[0-9]{1,3}(/(3[0-2]|[12]?[0-9]))?$|^[0-9a-fA-F]{0,4}(:[0-9a-fA-F]{0,4}){2,7}(/(12[0-8]|1[01][0-9]|[0-9]{1,2}))?$"
    },
    {
      "name": "access_type",
      "type": "enum",
      "label": "访问权限类型",
      "help": "RW 读写，RO 只读",
      "options": [
        "RW",
        "RO"
      ],
      "default": "RW",
      "group": "base"
    },
    {
      "name": "squash",
      "type": "enum",
      "label": "Root 权限压制策略",
      "options": [
        "root_squash",
        "no_root_squash",
        "all_squash"
      ],
      "default": "no_root_squash",
      "group": "base"
    },
    {
      "name": "enable_v3",
      "type": "boolean",
      "label": "启用 NFSv3 协议",
      "help": "部分 BMC 仅支持 v3 挂载",
      "default": true,
      "group": "base"
    },
    {
      "name": "enable_v4",
      "type": "boolean",
      "label": "启用 NFSv4 协议",
      "default": true,
      "group": "base"
    },
    {
      "name": "fault_mode",
      "type": "enum",
      "label": "BMC 故障注入模式",
      "options": [
        "none",
        "access_denied",
        "force_readonly"
      ],
      "default": "none",
      "group": "fault"
    }
  ]
}
