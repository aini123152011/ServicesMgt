{
  "fields": [
    {
      "name": "workgroup",
      "type": "string",
      "label": "Samba 工作组名称",
      "default": "WORKGROUP",
      "pattern": "^[a-zA-Z0-9_-]{1,32}$",
      "required": true,
      "group": "base"
    },
    {
      "name": "share_name",
      "type": "string",
      "label": "共享名称",
      "help": "客户端访问路径：\\\\host\\<share_name>",
      "default": "bmc_share",
      "pattern": "^[a-zA-Z0-9_-]{1,32}$",
      "required": true,
      "group": "base"
    },
    {
      "name": "read_only",
      "type": "boolean",
      "label": "只读共享开关",
      "default": false,
      "group": "base"
    },
    {
      "name": "guest_ok",
      "type": "boolean",
      "label": "允许 Guest 匿名读取",
      "default": false,
      "group": "base"
    },
    {
      "name": "min_protocol",
      "type": "enum",
      "label": "支持的最低 SMB 协议版本",
      "options": [
        "SMB2_02",
        "SMB2_10",
        "SMB3_00",
        "SMB3_11"
      ],
      "default": "SMB2_02",
      "group": "base"
    },
    {
      "name": "username",
      "type": "string",
      "label": "Samba 认证用户名",
      "default": "smbuser",
      "pattern": "^[a-zA-Z0-9_-]{1,32}$",
      "required": true,
      "group": "base"
    },
    {
      "name": "password",
      "type": "string",
      "label": "Samba 认证密码",
      "secret": true,
      "default": "bmc-fixture-pass",
      "required": true,
      "group": "base"
    },
    {
      "name": "log_root",
      "type": "string",
      "label": "日志归档根目录",
      "default": "/var/log/samba",
      "help": "smbd 日志的根目录（默认沿用 /var/log/samba），日期目录在其下自动创建；要跨容器重建保留日志，需把该路径挂成数据卷",
      "pattern": "^/[A-Za-z0-9._/\\-]+$",
      "group": "base"
    },
    {
      "name": "date_dir",
      "type": "enum",
      "label": "日期目录层级",
      "default": "daily",
      "options": [
        "daily",
        "monthly",
        "none"
      ],
      "help": "日志目录按日期组织：daily=年-月-日 三级；monthly=年-月 两级；none=不按日期建目录，文件直接落在归档根目录",
      "group": "base"
    },
    {
      "name": "fault_mode",
      "type": "enum",
      "label": "BMC 故障注入模式",
      "options": [
        "none",
        "force_protocol_mismatch",
        "auth_reject"
      ],
      "default": "none",
      "group": "fault"
    }
  ]
}
